# Copy to .env for local development.
# Never commit .env.

APP_ENV=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg://researchos:researchos@localhost:5432/researchos

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MinIO / S3-compatible storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=researchos

# LLM
GEMINI_API_KEY=

# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
